# ResolveAI Environment Configuration
# Copy to .env and fill in values. Never commit .env to git.

# Database
DATABASE_URL=postgresql+asyncpg://resolveai:resolveai@db:5432/resolveai

# Security
JWT_SECRET=change-me-in-production-use-a-long-random-string
COOKIE_DOMAIN=localhost

# LLM Configuration (pluggable via LLM_PROVIDER)
LLM_PROVIDER=gemini
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL_FAST=gemini-2.0-flash
LLM_MODEL_REASONING=gemini-2.5-pro

# Embeddings (local, no API key needed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Business API
BUSINESS_API_BASE_URL=http://localhost:8000/mock/v1
BUSINESS_API_KEY=dev-business-key

# CORS
FRONTEND_ORIGIN=http://localhost:3000

# Features
DEMO_MODE=true
LOG_LEVEL=INFO

# Thresholds (all configurable - see backend/app/config.py for descriptions)
MATCH_SEMANTIC_MIN=0.78
MATCH_CONFIRM_MIN=0.85
MATCH_AMBIGUITY_GAP=0.07
REPEAT_ESCALATE_AT=3
CONTACT_DEBOUNCE_MINUTES=10
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_CONFIDENCE=0.55
THREAD_FULL_LOAD_MAX_TOKENS=3000
SLA_HOURS_PAYMENT=24
SLA_HOURS_DELIVERY=72
SLA_SWEEP_MINUTES=15
RETENTION_DAYS=365
SESSION_TTL_MINUTES=60
RATE_LIMIT_PER_MIN=20

